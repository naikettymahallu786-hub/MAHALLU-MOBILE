{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mahallu.app/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.mahallu.app/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
