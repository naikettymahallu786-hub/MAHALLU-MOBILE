{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mahallu-4d9t.onrender.com/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mahallu-backend-cv55.onrender.com/api/v1"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mahallu-backend-cv55.onrender.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
